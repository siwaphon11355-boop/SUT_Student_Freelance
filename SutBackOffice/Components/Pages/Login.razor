@page "/"
@page "/login"
@layout Layout.EmptyLayout
@inject NavigationManager Nav

<PageTitle>เข้าสู่ระบบจัดการหลังบ้าน · SUT Freelance</PageTitle>

<div class="login-screen">
    <svg class="petals" viewBox="-100 -100 200 200" aria-hidden="true">
        <g fill="#fff">
            @for (var i = 0; i < 16; i++)
            {
                var r = (i * 22.5).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
                var sk = i % 2 != 0 ? "-12" : "12";
                var op = i % 2 != 0 ? ".12" : ".2";
                <rect x="-14" y="-92" width="28" height="42" rx="5" transform="rotate(@r) skewX(@sk)" fill-opacity="@op" />
            }
            @for (var i = 0; i < 12; i++)
            {
                var r = (i * 30 + 15).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
                <rect x="-11" y="-62" width="22" height="30" rx="4" transform="rotate(@r) skewX(10)" fill-opacity=".14" />
            }
        </g>
    </svg>

    <div class="brand"><b>SUT</b><span>มหาวิทยาลัย<br />เทคโนโลยีสุรนารี</span></div>
    <div class="band"><p>มหาวิทยาลัยแห่งนวัตกรรมและความยั่งยืน</p></div>

    <div class="stage">
        <form class="card" @onsubmit="SignIn" autocomplete="on">
            @if (showAlert)
            {
                <div class="login-alert" style="background:#FEE2E2;border-left:4px solid #BE123C;color:#BE123C;display:flex;gap:10px;padding:12px 16px;border-radius:14px;margin-bottom:18px;font-size:13px;align-items:center;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    <div style="flex:1">
                        <strong style="display:block">ข้อมูลยืนยันตัวตนไม่ถูกต้อง</strong>
                        <span style="font-size:12px">กรุณาใช้อีเมล @@sut.ac.th และรหัสผ่านที่ถูกต้อง</span>
                    </div>
                    <button type="button" @onclick="() => showAlert = false" style="background:none;border:0;color:#BE123C;cursor:pointer;font-size:16px;line-height:1">✕</button>
                </div>
            }

            <div class="logo">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/></svg>
            </div>
            <h1>SUT Freelance</h1>

            <div class="lab"><label for="em">อีเมลเจ้าหน้าที่ / บัญชีผู้ใช้ มทส.</label><small>@@sut.ac.th</small></div>
            <div class="field">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="m3 8 9 6 9-6"/></svg>
                <input id="em" type="email" @bind="email" autocomplete="username" />
            </div>

            <div class="lab"><label for="pw">รหัสผ่าน</label><small>แยกแยะตัวพิมพ์ใหญ่-เล็ก</small></div>
            <div class="field">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="3"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
                <input id="pw" type="@(showPw ? "text" : "password")" @bind="password" autocomplete="current-password" />
                <button type="button" class="eye" @onclick="() => showPw = !showPw" aria-label="แสดงรหัสผ่าน">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
                </button>
            </div>

            <div class="opts">
                <label class="chk">
                    <input type="checkbox" @bind="remember" />
                    <i><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-10"/></svg></i>
                    จดจำอุปกรณ์เครื่องนี้
                </label>
                <a href="#" @onclick:preventDefault>ลืมรหัสผ่าน</a>
            </div>

            <button class="go @(isLoading ? "load" : "")" type="submit" disabled="@isLoading">
                <span>เข้าสู่ระบบจัดการหลังบ้าน</span>
                @if (isLoading)
                {
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.2-8.6"/></svg>
                }
                else
                {
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                }
            </button>
        </form>
    </div>
</div>

<style>
.login-screen {
    position: fixed;
    inset: 0;
    overflow-y: auto;
    overflow-x: hidden;
    background: radial-gradient(900px 560px at 18% 12%, #FF8A3D 0%, transparent 65%),
                radial-gradient(800px 600px at 90% 80%, #FF5A00 0%, transparent 60%),
                linear-gradient(160deg, #FF7A1F, #F2600F);
    font-family: 'IBM Plex Sans Thai', 'Noto Sans Thai', system-ui, sans-serif;
    color: #1B1612;
    z-index: 100;
}
.petals {
    position: fixed;
    right: -160px;
    bottom: -190px;
    width: 760px;
    height: 760px;
    opacity: .9;
    pointer-events: none;
    animation: petals-spin 180s linear infinite;
}
@@keyframes petals-spin { to { transform: rotate(360deg); } }
.band {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    height: 22vh;
    min-height: 150px;
    background: linear-gradient(180deg, rgba(27,22,18,.55), rgba(27,22,18,.88));
    backdrop-filter: blur(22px) saturate(150%);
    -webkit-backdrop-filter: blur(22px) saturate(150%);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.14);
    z-index: 1;
}
.band p {
    position: absolute;
    right: 56px;
    bottom: 34px;
    font-size: clamp(16px, 1.6vw, 22px);
    font-weight: 600;
    color: #FF9A3D;
    letter-spacing: .01em;
}
.brand {
    position: fixed;
    top: 44px;
    right: 56px;
    color: #fff;
    text-align: left;
    z-index: 2;
}
.brand b {
    display: block;
    font-size: 64px;
    font-weight: 700;
    letter-spacing: -.02em;
    line-height: .95;
    position: relative;
    padding-right: 28px;
}
.brand b::after {
    content: "";
    position: absolute;
    right: 0;
    top: -6px;
    width: 26px;
    height: 26px;
    border-top: 5px solid #fff;
    border-right: 5px solid #fff;
}
.brand span {
    display: block;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.3;
    margin-top: 10px;
    opacity: .95;
}
.stage {
    position: relative;
    z-index: 3;
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 24px 16px 20vh;
}
.card {
    width: min(100%, 440px);
    background: #fff;
    border-radius: 28px;
    padding: 40px 36px 36px;
    box-shadow: 0 2px 4px rgba(60,28,0,.08), 0 40px 80px -24px rgba(60,10,0,.55);
    animation: card-rise .8s cubic-bezier(.2,.8,.2,1) both;
}
@@keyframes card-rise {
    from { opacity: 0; transform: translateY(24px) scale(.98); }
    to { opacity: 1; transform: none; }
}
.logo {
    width: 68px;
    height: 68px;
    border-radius: 22px;
    margin: 0 auto 18px;
    display: grid;
    place-items: center;
    color: #fff;
    background: linear-gradient(145deg, #FF9A3D, #FF6B00);
    box-shadow: 0 14px 26px -8px rgba(255,107,0,.75), inset 0 1px 0 rgba(255,255,255,.35);
}
.card h1 {
    text-align: center;
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -.01em;
    margin-bottom: 30px;
    color: #1B1612;
}
.lab {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 8px;
    font-size: 14px;
    font-weight: 600;
    color: #1B1612;
}
.lab small { font-size: 12px; font-weight: 400; color: #85786d; }
.field {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 54px;
    padding: 0 16px;
    border-radius: 16px;
    background: #FFF3E8;
    color: #85786d;
    box-shadow: inset 0 0 0 1.5px transparent, inset 0 2px 4px rgba(120,60,0,.06);
    transition: box-shadow .25s, background .25s, transform .25s;
    margin-bottom: 22px;
}
.field:hover { transform: translateY(-1px); }
.field:focus-within {
    background: #fff;
    color: #FF6B00;
    box-shadow: inset 0 0 0 2px #FF6B00, 0 10px 22px -10px rgba(255,107,0,.55);
}
.field input {
    flex: 1;
    min-width: 0;
    height: 100%;
    border: 0;
    outline: 0;
    background: none;
    font: inherit;
    font-size: 15px;
    color: #1B1612;
}
.eye {
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 10px;
    transition: .2s;
}
.eye:hover { background: rgba(255,107,0,.12); color: #FF6B00; }
.opts {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: -2px 0 24px;
    font-size: 14px;
}
.chk {
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    user-select: none;
    color: #1B1612;
}
.chk input { position: absolute; opacity: 0; }
.chk i {
    width: 22px;
    height: 22px;
    border-radius: 7px;
    background: #FFF3E8;
    display: grid;
    place-items: center;
    color: #fff;
    box-shadow: inset 0 0 0 1.5px rgba(255,107,0,.3);
    transition: .2s;
}
.chk i svg { opacity: 0; transform: scale(.4); transition: .25s cubic-bezier(.3,1.6,.5,1); }
.chk input:checked + i {
    background: linear-gradient(135deg, #FF9A3D, #FF6B00);
    box-shadow: 0 6px 12px -4px rgba(255,107,0,.7);
}
.chk input:checked + i svg { opacity: 1; transform: none; }
.opts a {
    color: #FF6B00;
    font-weight: 600;
    text-decoration: none;
    position: relative;
}
.opts a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 100%;
    bottom: -2px;
    height: 2px;
    background: #FF6B00;
    transition: right .25s;
}
.opts a:hover::after { right: 0; }
.go {
    width: 100%;
    height: 56px;
    border: 0;
    border-radius: 18px;
    font: inherit;
    font-size: 16px;
    font-weight: 600;
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: linear-gradient(135deg, #FF9A3D, #FF6B00);
    box-shadow: 0 14px 26px -8px rgba(255,107,0,.8), inset 0 1px 0 rgba(255,255,255,.3);
    transition: transform .25s, box-shadow .25s;
    position: relative;
    overflow: hidden;
}
.go::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, transparent 30%, rgba(255,255,255,.4), transparent 70%);
    transform: translateX(-120%);
    transition: transform .7s;
}
.go:hover {
    transform: translateY(-2px);
    box-shadow: 0 20px 32px -8px rgba(255,107,0,.9), inset 0 1px 0 rgba(255,255,255,.3);
}
.go:hover::after { transform: translateX(120%); }
.go svg { transition: transform .25s; }
.go:hover svg { transform: translateX(5px); }
.go:active { transform: scale(.98); }
.go.load svg { animation: go-spin 0.8s linear infinite; }
@@keyframes go-spin { to { transform: rotate(360deg); } }

@@media (max-width: 760px) {
    .brand { top: 20px; right: 20px; }
    .brand b { font-size: 40px; }
    .brand span { font-size: 13px; }
    .band p { right: 20px; bottom: 18px; left: 20px; text-align: right; }
    .card { padding: 32px 22px 26px; }
    .stage { padding-top: 130px; }
    .petals { width: 520px; height: 520px; }
}
</style>

@code {
    string email = "admin.auth@sut.ac.th";
    string password = "password1234567";
    bool showPw, remember = true, showAlert, isLoading;

    async Task SignIn()
    {
        var ok = email.Trim().EndsWith("@sut.ac.th", StringComparison.OrdinalIgnoreCase) && password.Length >= 4;
        if (ok)
        {
            isLoading = true;
            await Task.Delay(400);
            Nav.NavigateTo("/dashboard");
            return;
        }
        showAlert = true;
    }
}